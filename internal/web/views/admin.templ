package views

import (
	"strconv"
	"time"

	"github.com/jackc/pgx/v5/pgtype"

	"github.com/Blackopuss/SAAS-Whatsapp/internal/db"
)

// Las páginas del superadmin las pinta frontend/src/admin.tsx; aquí solo se arman sus datos ya formateados.
// Solo viajan los campos que la pantalla muestra.

func Money(c int32) string { return money(c) }

// pesos: valor para un input de precio ("149" o "149.50").
func pesos(c int32) string {
	s := strconv.FormatInt(int64(c)/100, 10)
	if r := c % 100; r != 0 {
		return s + "." + strconv.FormatInt(int64(r)+100, 10)[1:]
	}
	return s
}

func statusLabel(s string) string {
	if s == "active" {
		return "Abierta"
	}
	return "En pausa"
}

func fecha(d pgtype.Date) string {
	if !d.Valid {
		return "sin pagos"
	}
	return d.Time.Format("02/01/2006")
}

var mx = func() *time.Location {
	l, err := time.LoadLocation("America/Mexico_City")
	if err != nil {
		return time.FixedZone("CST", -6*3600)
	}
	return l
}()

// overdue: ya pasó la fecha pagada (hoy en Ciudad de México).
func overdue(d pgtype.Date) bool {
	if !d.Valid {
		return false
	}
	y, m, day := time.Now().In(mx).Date()
	return d.Time.Before(time.Date(y, m, day, 0, 0, 0, 0, time.UTC))
}

templ AdminLogin(email, errMsg string) {
	@reactPage("Superadmin", "", "admin", "login", map[string]string{"email": email, "error": errMsg})
}

type adminStoreRow struct {
	ID        int64  `json:"id"`
	Name      string `json:"name"`
	Slug      string `json:"slug"`
	Active    bool   `json:"active"`
	Status    string `json:"status"`
	PaidUntil string `json:"paidUntil"`
	Overdue   bool   `json:"overdue"`
	Streak    int32  `json:"streak"`
	Founder   bool   `json:"founder"`
	Products  int64  `json:"products"`
	Orders    int64  `json:"orders"` // pedidos de los últimos 30 días: solo el número, para ver qué tiendas usan la plataforma
}

func adminStoresData(stores []db.ListStoresAdminRow) map[string]any {
	rows := make([]adminStoreRow, 0, len(stores))
	for _, s := range stores {
		rows = append(rows, adminStoreRow{s.ID, s.Name, s.Slug, s.Status == "active", statusLabel(s.Status), fecha(s.PaidUntil), overdue(s.PaidUntil), s.StreakMonths, s.IsFounder, s.Products, s.Orders30d})
	}
	return map[string]any{"stores": rows}
}

templ AdminStores(stores []db.ListStoresAdminRow) {
	@reactPage("Tiendas · Superadmin", "", "admin", "stores", adminStoresData(stores))
}

type NewStoreForm struct {
	Slug, Name, Email, Whatsapp, Price, Error string
	Founder                                   bool
}

templ AdminStoreNew(f NewStoreForm) {
	@reactPage("Nueva tienda · Superadmin", "", "admin", "storeNew", f)
}

type AdminStoreView struct {
	Store                                        db.GetStoreAdminRow
	Payments                                     []db.Payment
	Today, ShopURL, PaidUntil, Notice, Error, OK string
}

type adminPayment struct {
	Amount string `json:"amount"`
	Months int32  `json:"months"`
	PaidOn string `json:"paidOn"`
	OnTime bool   `json:"onTime"`
	Covers string `json:"covers"`
	Note   string `json:"note"`
}

func adminStoreData(v AdminStoreView) map[string]any {
	ps := make([]adminPayment, 0, len(v.Payments))
	for _, p := range v.Payments {
		ps = append(ps, adminPayment{money(p.AmountCents), p.Months, fecha(p.PaidOn), p.OnTime, fecha(p.NewPaidUntil), p.Note})
	}
	s := v.Store
	return map[string]any{
		"id": s.ID, "name": s.Name, "shopURL": v.ShopURL, "active": s.Status == "active", "status": statusLabel(s.Status),
		"paidUntil": v.PaidUntil, "overdue": overdue(s.PaidUntil), "streak": s.StreakMonths, "price": money(s.PriceCents),
		"priceInput": pesos(s.PriceCents), "founder": s.IsFounder, "notice": v.Notice, "error": v.Error, "ok": v.OK,
		"today": v.Today, "payments": ps,
	}
}

templ AdminStore(v AdminStoreView) {
	@reactPage(v.Store.Name+" · Superadmin", "", "admin", "store", adminStoreData(v))
}

templ AdminResetLink(title, link, wa string, storeID int64) {
	@reactPage(title+" · Superadmin", "", "admin", "resetLink", map[string]any{"title": title, "link": link, "wa": wa, "storeID": storeID})
}

type adminAuditRow struct {
	Action string `json:"action"`
	Store  string `json:"store"`
	When   string `json:"when"`
	Who    string `json:"who"`
	Detail string `json:"detail"`
}

func adminAuditData(rows []db.ListAuditRow) map[string]any {
	out := make([]adminAuditRow, 0, len(rows))
	for _, a := range rows {
		out = append(out, adminAuditRow{a.Action, a.Store, a.CreatedAt.Time.In(mx).Format("02/01/2006 15:04"), a.Who, a.Detail})
	}
	return map[string]any{"rows": out}
}

templ AdminAudit(rows []db.ListAuditRow) {
	@reactPage("Bitácora · Superadmin", "", "admin", "audit", adminAuditData(rows))
}
