package views

import (
	"strconv"
	"time"

	"github.com/jackc/pgx/v5/pgtype"

	"github.com/Blackopuss/SAAS-Whatsapp/internal/db"
)

templ AdminLogin(email, errMsg string) {
	@page("Superadmin", "") {
		<main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center p-4">
			<h1 class="text-2xl font-bold">Superadmin</h1>
			<form method="post" action="/login" class="mt-6 flex flex-col gap-4" novalidate>
				@alert(errMsg)
				<div class="flex flex-col gap-1">
					<label for="email" class="font-medium">Email</label>
					<input id="email" name="email" type="email" value={ email } autocomplete="username" required autofocus?={ email == "" } class={ input }/>
				</div>
				<div class="flex flex-col gap-1">
					<label for="password" class="font-medium">Contraseña</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required autofocus?={ email != "" } class={ input }/>
				</div>
				<div class="flex flex-col gap-1">
					<label for="code" class="font-medium">Código de tu app de autenticación</label>
					<input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9 ]*" maxlength="7" autocomplete="one-time-code" required class={ input }/>
				</div>
				<button type="submit" class={ btn }>Entrar</button>
			</form>
		</main>
	}
}

templ adminPage(title string) {
	@page(title+" · Superadmin", "") {
		<main class="mx-auto max-w-xl p-4 pb-12">
			<nav aria-label="Superadmin" class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-stone-300 pb-3">
				<a href="/" class="font-medium underline underline-offset-4">Tiendas</a>
				<a href="/tiendas/nueva" class="font-medium underline underline-offset-4">Nueva tienda</a>
				<a href="/bitacora" class="font-medium underline underline-offset-4">Bitácora</a>
				<form method="post" action="/logout" class="ml-auto"><button type="submit" class={ btnAlt }>Salir</button></form>
			</nav>
			<h1 class="text-2xl font-bold">{ title }</h1>
			{ children... }
		</main>
	}
}

func Money(c int32) string { return money(c) }

// pesos: valor para un input de precio ("149" o "149.50").
func pesos(c int32) string {
	s := strconv.FormatInt(int64(c)/100, 10)
	if r := c % 100; r != 0 {
		return s + "." + strconv.FormatInt(int64(r)+100, 10)[1:]
	}
	return s
}

func statusLabel(s string) string {
	if s == "active" {
		return "Abierta"
	}
	return "En pausa"
}

func fecha(d pgtype.Date) string {
	if !d.Valid {
		return "sin pagos"
	}
	return d.Time.Format("02/01/2006")
}

var mx = func() *time.Location {
	l, err := time.LoadLocation("America/Mexico_City")
	if err != nil {
		return time.FixedZone("CST", -6*3600)
	}
	return l
}()

templ AdminStores(stores []db.ListStoresAdminRow) {
	@adminPage("Tiendas") {
		if len(stores) == 0 {
			<p class="mt-6">Aún no hay tiendas. <a href="/tiendas/nueva" class="font-medium underline underline-offset-4">Da de alta la primera</a>.</p>
		}
		<ul class="mt-6 flex flex-col gap-3">
			for _, s := range stores {
				<li class="rounded-lg border border-stone-300 bg-white p-4">
					<p class="font-bold"><a href={ templ.SafeURL("/tiendas/" + idStr(s.ID)) } class="underline underline-offset-4">{ s.Name }</a></p>
					<p class="text-stone-700">
						{ s.Slug } · { statusLabel(s.Status) } · pagado hasta { fecha(s.PaidUntil) }
						if s.StreakMonths > 0 {
							· racha de { strconv.Itoa(int(s.StreakMonths)) } meses
						}
						if s.IsFounder {
							· fundadora
						}
					</p>
					<p class="text-sm text-stone-600">{ strconv.FormatInt(s.Products, 10) } productos</p>
				</li>
			}
		</ul>
	}
}

type NewStoreForm struct {
	Slug, Name, Email, Whatsapp, Price, Error string
	Founder                                   bool
}

templ AdminStoreNew(f NewStoreForm) {
	@adminPage("Nueva tienda") {
		<form method="post" action="/tiendas" class="mt-6 flex flex-col gap-5" novalidate>
			@alert(f.Error)
			@helpField("slug", "Subdominio", "Minúsculas, números y guiones. Será la dirección de la tienda.") {
				<input id="slug" name="slug" type="text" value={ f.Slug } required autocapitalize="none" spellcheck="false" aria-describedby="slug-help" class={ input }/>
			}
			@helpField("name", "Nombre de la tienda", "") {
				<input id="name" name="name" type="text" value={ f.Name } maxlength="80" required class={ input }/>
			}
			@helpField("email", "Email de la dueña", "Con él entra a su panel.") {
				<input id="email" name="email" type="email" value={ f.Email } required aria-describedby="email-help" class={ input }/>
			}
			@helpField("whatsapp", "WhatsApp de la dueña (opcional)", "Para mandarle su enlace de acceso y recibir pedidos.") {
				<input id="whatsapp" name="whatsapp" type="tel" inputmode="tel" value={ f.Whatsapp } aria-describedby="whatsapp-help" class={ input }/>
			}
			@helpField("price", "Precio mensual", "En pesos.") {
				<input id="price" name="price" type="text" inputmode="decimal" value={ f.Price } required aria-describedby="price-help" class={ input }/>
			}
			<label class="flex min-h-11 items-center gap-3"><input type="checkbox" name="founder" checked?={ f.Founder } class="size-5"/>Es fundadora</label>
			<button type="submit" class={ btn }>Dar de alta</button>
		</form>
	}
}

type AdminStoreView struct {
	Store                                        db.GetStoreAdminRow
	Payments                                     []db.Payment
	Today, ShopURL, PaidUntil, Notice, Error, OK string
}

templ AdminStore(v AdminStoreView) {
	@adminPage(v.Store.Name) {
		<p class="mt-2"><a href={ templ.SafeURL(v.ShopURL) } class="underline underline-offset-4">{ v.ShopURL }</a></p>
		<div class="mt-4 flex flex-col gap-3">
			@alert(v.Error)
			if v.OK != "" {
				<p role="status" class="rounded-md border border-green-300 bg-green-50 p-3 text-green-900">{ v.OK }</p>
			}
			if v.Notice != "" {
				<p class="rounded-md border border-amber-300 bg-amber-50 p-3 text-amber-950">Lo que ve la dueña: { v.Notice }</p>
			}
		</div>
		<dl class="mt-4 grid grid-cols-2 gap-2 rounded-lg border border-stone-300 bg-white p-4">
			<dt class="text-stone-600">Estado</dt>
			<dd class="font-medium">{ statusLabel(v.Store.Status) }</dd>
			<dt class="text-stone-600">Pagado hasta</dt>
			<dd class="font-medium">
				if v.PaidUntil != "" {
					{ v.PaidUntil }
				} else {
					Sin pagos
				}
			</dd>
			<dt class="text-stone-600">Racha</dt>
			<dd class="font-medium">{ strconv.Itoa(int(v.Store.StreakMonths)) } meses</dd>
			<dt class="text-stone-600">Precio</dt>
			<dd class="font-medium">
				{ money(v.Store.PriceCents) } al mes
				if v.Store.IsFounder {
					· fundadora
				}
			</dd>
		</dl>
		<section aria-labelledby="pago-h" class="mt-8">
			<h2 id="pago-h" class="text-xl font-bold">Registrar pago</h2>
			<form method="post" action={ templ.SafeURL("/tiendas/" + idStr(v.Store.ID) + "/pagos") } class="mt-3 flex flex-col gap-4" novalidate>
				<div class="grid grid-cols-2 gap-3">
					@helpField("amount", "Monto", "") {
						<input id="amount" name="amount" type="text" inputmode="decimal" value={ pesos(v.Store.PriceCents) } required class={ input }/>
					}
					@helpField("months", "Meses", "") {
						<select id="months" name="months" class={ input }>
							for _, m := range []int{1, 2, 3, 6, 12} {
								<option value={ strconv.Itoa(m) }>{ strconv.Itoa(m) }</option>
							}
						</select>
					}
				</div>
				@helpField("paid_on", "Fecha del pago", "") {
					<input id="paid_on" name="paid_on" type="date" value={ v.Today } max={ v.Today } required class={ input }/>
				}
				@helpField("note", "Nota (opcional)", "Por ejemplo: transferencia BBVA, referencia 1234.") {
					<input id="note" name="note" type="text" maxlength="200" aria-describedby="note-help" class={ input }/>
				}
				<button type="submit" class={ btn }>Registrar pago</button>
			</form>
		</section>
		<section aria-labelledby="hist-h" class="mt-8">
			<h2 id="hist-h" class="text-xl font-bold">Pagos</h2>
			if len(v.Payments) == 0 {
				<p class="mt-2 text-stone-700">Aún no hay pagos.</p>
			}
			<ul class="mt-3 flex flex-col gap-2">
				for _, p := range v.Payments {
					<li class="rounded-md border border-stone-300 bg-white p-3">
						<p class="font-medium">{ money(p.AmountCents) } · { strconv.Itoa(int(p.Months)) } mes(es) · { fecha(p.PaidOn) }</p>
						<p class="text-sm text-stone-700">
							if p.OnTime {
								A tiempo
							} else {
								Con atraso
							}
							· cubre hasta { fecha(p.NewPaidUntil) }
							if p.Note != "" {
								· { p.Note }
							}
						</p>
					</li>
				}
			</ul>
		</section>
		<section aria-labelledby="plan-h" class="mt-8">
			<h2 id="plan-h" class="text-xl font-bold">Plan</h2>
			<form method="post" action={ templ.SafeURL("/tiendas/" + idStr(v.Store.ID) + "/plan") } class="mt-3 flex flex-col gap-4" novalidate>
				@helpField("price", "Precio mensual", "En pesos.") {
					<input id="price" name="price" type="text" inputmode="decimal" value={ pesos(v.Store.PriceCents) } required aria-describedby="price-help" class={ input }/>
				}
				<label class="flex min-h-11 items-center gap-3"><input type="checkbox" name="founder" checked?={ v.Store.IsFounder } class="size-5"/>Es fundadora</label>
				<button type="submit" class={ btnAlt }>Guardar plan</button>
			</form>
		</section>
		<section aria-labelledby="acc-h" class="mt-8 flex flex-col gap-3">
			<h2 id="acc-h" class="text-xl font-bold">Acceso y estado</h2>
			<form method="post" action={ templ.SafeURL("/tiendas/" + idStr(v.Store.ID) + "/recuperar") }>
				<button type="submit" class={ btnAlt }>Enlace para nueva contraseña</button>
			</form>
			if v.Store.Status == "active" {
				<details class="rounded-md border border-stone-300 bg-white p-3">
					<summary class="min-h-11 cursor-pointer content-center font-medium text-red-800">Pausar tienda</summary>
					<form method="post" action={ templ.SafeURL("/tiendas/" + idStr(v.Store.ID) + "/pausar") } class="mt-3 flex flex-col gap-3">
						<p>Las compradoras verán "Tienda en pausa". La dueña puede seguir entrando a su panel.</p>
						@helpField("reason", "Motivo (queda en la bitácora)", "") {
							<input id="reason" name="reason" type="text" maxlength="200" class={ input }/>
						}
						<button type="submit" class="min-h-12 rounded-md bg-red-800 px-4 font-medium text-white">Pausar { v.Store.Name }</button>
					</form>
				</details>
			} else {
				<form method="post" action={ templ.SafeURL("/tiendas/" + idStr(v.Store.ID) + "/reactivar") }>
					<button type="submit" class={ btn }>Reactivar tienda</button>
				</form>
			}
		</section>
	}
}

templ AdminResetLink(title, link, wa string, storeID int64) {
	@adminPage(title) {
		<p class="mt-6">El enlace vence en 30 minutos y sirve una sola vez. Mándaselo solo a la dueña.</p>
		<label for="link" class="mt-4 block font-medium">Enlace</label>
		<input id="link" type="text" readonly value={ link } class={ input + " w-full" }/>
		if wa != "" {
			<a href={ templ.SafeURL(wa) } class={ btn + " mt-4 block text-center" }>Enviar por WhatsApp</a>
		}
		<p class="mt-6"><a href={ templ.SafeURL("/tiendas/" + idStr(storeID)) } class="font-medium underline underline-offset-4">Ir a la tienda</a></p>
	}
}

templ AdminAudit(rows []db.ListAuditRow) {
	@adminPage("Bitácora") {
		if len(rows) == 0 {
			<p class="mt-6">Aún no hay acciones registradas.</p>
		}
		<ol class="mt-6 flex flex-col gap-2">
			for _, a := range rows {
				<li class="rounded-md border border-stone-300 bg-white p-3">
					<p class="font-medium">
						{ a.Action }
						if a.Store != "" {
							· { a.Store }
						}
					</p>
					<p class="text-sm text-stone-700">
						{ a.CreatedAt.Time.In(mx).Format("02/01/2006 15:04") } · { a.Who }
						if a.Detail != "" {
							· { a.Detail }
						}
					</p>
				</li>
			}
		</ol>
	}
}
