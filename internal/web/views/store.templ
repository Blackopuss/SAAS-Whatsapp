package views

import (
	"net/url"
	"strconv"
	"strings"

	"github.com/Blackopuss/SAAS-Whatsapp/internal/db"
)

type Shop struct {
	Name       string
	Categories []db.Category
	Current    int64  // categoría activa en la navegación; 0 = Todo
	Whatsapp   string // E.164 sin "+", o vacío
	Brand      string // color ya ajustado por contraste; vacío = el de la plantilla
	BrandInk   string
	Logo       Photo
	FAQ        []QA
	Payment    string
	URL        string // URL absoluta de esta página (Open Graph)
	OGImage    string
	Preview    bool // dentro del <iframe> de "Mi tienda": los links abren en otra pestaña
	Style      string
}

type QA struct{ Q, A string }

type Card struct {
	ID         int64
	Name       string
	Price, Was int32 // Was > 0 = en oferta
	SoldOut    bool
	New        bool
	Photo      Photo
	Color      string // color dominante de la foto: fondo mientras carga
	Sizes      []string
}

type Opt struct {
	Name    string
	SoldOut bool
	Swatch  string
}

type ProductPage struct {
	Card
	Description   string
	Photos        []Photo
	CategoryID    int64
	CategoryName  string
	Sizes, Colors []Opt
	SoldOutCombos []string
}

// placeholders: fondos del color de cada foto mientras carga. Va en <style nonce> porque la CSP prohíbe style="".
// Los valores vienen de images.DominantColor (#rrggbb) o del mapa de swatches; se validan igual.
func placeholders(cs []Card) string {
	var b strings.Builder
	for _, c := range cs {
		if isHex(c.Color) {
			b.WriteString(".ph-" + idStr(c.ID) + "{background:" + c.Color + "}")
		}
	}
	return b.String()
}

func swatchCSS(opts []Opt) string {
	var b strings.Builder
	for i, o := range opts {
		if isHex(o.Swatch) {
			b.WriteString(".sw-" + strconv.Itoa(i) + "{background:" + o.Swatch + "}")
		}
	}
	return b.String()
}

func isHex(s string) bool {
	if len(s) != 7 || s[0] != '#' {
		return false
	}
	for _, r := range s[1:] {
		if !strings.ContainsRune("0123456789abcdefABCDEF", r) {
			return false
		}
	}
	return true
}

func jsonList(xs []string) string {
	if len(xs) == 0 {
		return "[]"
	}
	q := make([]string, len(xs))
	for i, x := range xs {
		q[i] = strconv.Quote(x)
	}
	return "[" + strings.Join(q, ",") + "]"
}

templ nonceStyle(css string) {
	if css != "" {
		@templ.Raw(`<style nonce="` + templ.GetNonce(ctx) + `">` + css + `</style>`)
	}
}

templ shopPage(sh Shop, title, description string, home bool) {
	<!DOCTYPE html>
	<html lang="es-MX">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ description }/>
			<title>{ title }</title>
			<meta property="og:type" content="website"/>
			<meta property="og:title" content={ title }/>
			<meta property="og:description" content={ description }/>
			if sh.URL != "" {
				<meta property="og:url" content={ sh.URL }/>
			}
			if sh.OGImage != "" {
				<meta property="og:image" content={ sh.OGImage }/>
			}
			if sh.Preview {
				<base target="_blank"/>
			}
			<link rel="preload" href={ "/static/fonts/" + StyleByID(sh.Style).Font } as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/static/css/vitrina.css"/>
			if isHex(sh.Brand) && isHex(sh.BrandInk) {
				@nonceStyle(":root{--brand:" + sh.Brand + ";--brand-ink:" + sh.BrandInk + "}")
			}
			<script type="speculationrules" nonce={ templ.GetNonce(ctx) }>
				{"prerender":[{"where":{"href_matches":"/p/*"},"eagerness":"moderate"}]}
			</script>
		</head>
		<body data-estilo={ StyleByID(sh.Style).ID }>
			<a class="skip" href="#contenido">Ir al contenido</a>
			<header class="top">
				if sh.Logo.Src != "" {
					<img class="logo" src={ sh.Logo.Src } alt="" width="56" height="56"/>
				}
				if home {
					<h1 class="shop-name">{ sh.Name }</h1>
				} else {
					<a class="shop-name" href="/">{ sh.Name }</a>
				}
			</header>
			<nav class="cats" aria-label="Categorías">
				<ul>
					@catLink("/", "Todo", sh.Current == 0 && home)
					for _, c := range sh.Categories {
						@catLink("/c/"+idStr(c.ID), c.Name, sh.Current == c.ID)
					}
					@catLink("/preguntas", "Preguntas", false)
				</ul>
			</nav>
			<main
				id="contenido"
				if sh.Preview {
					aria-label="Vista previa de la tienda"
				}
			>
				{ children... }
			</main>
			<button type="button" class="cart-btn" data-cart-open hidden>Carrito <span class="cart-n" data-cart-count>0</span></button>
			<dialog id="carrito" class="cart" closedby="any" aria-labelledby="carrito-h" data-tienda={ sh.Name } data-wa={ sh.Whatsapp }>
				<div class="cart-head">
					<h2 id="carrito-h">Tu carrito</h2>
					<form method="dialog"><button class="link">Cerrar</button></form>
				</div>
				<div aria-live="polite" data-cart-status></div>
				<ul class="cart-list" data-cart-list></ul>
				<p class="cart-empty" data-cart-empty>Tu carrito está vacío. <a href="/">Ve las novedades</a></p>
				<div class="cart-foot" data-cart-foot hidden>
					<p class="cart-total">Total <strong data-cart-total></strong></p>
					<a class="wa" data-cart-wa href="#" rel="noopener">Enviar pedido por WhatsApp</a>
					<p class="muted" data-cart-nowa hidden>Esta tienda aún no tiene WhatsApp. Vuelve pronto.</p>
				</div>
			</dialog>
			<script src="/static/js/carrito.js" defer></script>
		</body>
	</html>
}

templ catLink(href, name string, current bool) {
	<li>
		if current {
			<a href={ templ.SafeURL(href) } aria-current="page">{ name }</a>
		} else {
			<a href={ templ.SafeURL(href) }>{ name }</a>
		}
	</li>
}

templ grid(cards []Card) {
	@nonceStyle(placeholders(cards))
	if len(cards) == 0 {
		<p class="empty">Esta tienda aún no tiene productos. Vuelve pronto.</p>
	} else {
		<ul class="grid">
			for i, c := range cards {
				<li>
					@card(c, i < 2)
				</li>
			}
		</ul>
	}
}

templ card(c Card, eager bool) {
	<a class={ "card", templ.KV("sold", c.SoldOut) } href={ templ.SafeURL("/p/" + idStr(c.ID)) }>
		<span class={ "ph", "ph-" + idStr(c.ID) }>
			if c.Photo.Src != "" {
				if eager {
					<img src={ c.Photo.Src } srcset={ c.Photo.SrcSet } sizes="(min-width: 640px) 33vw, 50vw" alt="" width="400" height="500" fetchpriority="high"/>
				} else {
					<img src={ c.Photo.Src } srcset={ c.Photo.SrcSet } sizes="(min-width: 640px) 33vw, 50vw" alt="" width="400" height="500" loading="lazy" decoding="async"/>
				}
			}
			@tag(c)
		</span>
		<span class="name">{ c.Name }</span>
		<span class="price">
			@price(c)
		</span>
		if len(c.Sizes) > 0 && !c.SoldOut {
			<span class="sizes"><span class="sr-only">Tallas: </span>{ strings.Join(c.Sizes, " ") }</span>
		}
	</a>
}

templ tag(c Card) {
	if c.SoldOut {
		<span class="tag tag-out">Agotado</span>
	} else if c.Was > 0 {
		<span class="tag tag-sale">Oferta</span>
	} else if c.New {
		<span class="tag">Nuevo</span>
	}
}

templ price(c Card) {
	if c.Was > 0 {
		<span class="now">{ money(c.Price) }</span> <s><span class="sr-only">antes </span>{ money(c.Was) }</s>
	} else {
		{ money(c.Price) }
	}
}

templ ShopHome(sh Shop, cards []Card) {
	@shopPage(sh, sh.Name, "Catálogo de "+sh.Name+". Elige tus productos y haz tu pedido por WhatsApp.", true) {
		@grid(cards)
	}
}

templ ShopCategory(sh Shop, name string, cards []Card) {
	@shopPage(sh, name+" · "+sh.Name, name+" de "+sh.Name+". Haz tu pedido por WhatsApp.", false) {
		<h1 class="page-h">{ name }</h1>
		@grid(cards)
	}
}

templ ShopProduct(sh Shop, p ProductPage) {
	@shopPage(sh, p.Name+" · "+sh.Name, p.Name+" en "+sh.Name+": "+money(p.Price)+". Pídelo por WhatsApp.", false) {
		@nonceStyle(placeholders([]Card{p.Card}) + swatchCSS(p.Colors))
		<article class="product">
			if len(p.Photos) > 0 {
				<div class={ "gallery", "ph-" + idStr(p.ID), templ.KV("sold", p.SoldOut) } tabindex="0" aria-label={ "Fotos de " + p.Name }>
					for i, ph := range p.Photos {
						if i == 0 {
							<img id={ "foto-" + strconv.Itoa(i+1) } src={ ph.Src } srcset={ ph.SrcSet } sizes="(min-width: 640px) 560px, 100vw" alt={ p.Name } width="800" height="1000" fetchpriority="high"/>
						} else {
							<img id={ "foto-" + strconv.Itoa(i+1) } src={ ph.Src } srcset={ ph.SrcSet } sizes="(min-width: 640px) 560px, 100vw" alt={ p.Name + ", foto " + strconv.Itoa(i+1) } width="800" height="1000" loading="lazy" fetchpriority="low" decoding="async"/>
						}
					}
				</div>
				if len(p.Photos) > 1 {
					<nav class="dots" aria-label="Fotos">
						for i := range p.Photos {
							<a href={ templ.SafeURL("#foto-" + strconv.Itoa(i+1)) }><span class="sr-only">Ver foto { strconv.Itoa(i+1) }</span></a>
						}
					</nav>
				}
			}
			<div class="info">
				if p.CategoryName != "" {
					<p class="crumb"><a href={ templ.SafeURL("/c/" + idStr(p.CategoryID)) }>{ p.CategoryName }</a></p>
				}
				<h1 class="page-h">{ p.Name }</h1>
				<p class="price big">
					@price(p.Card)
				</p>
				if p.SoldOut {
					<p class="out">Agotado por ahora.</p>
				} else {
					<form class="add" data-add data-id={ idStr(p.ID) } data-price={ strconv.Itoa(int(p.Price)) } data-agotadas={ jsonList(p.SoldOutCombos) }>
						if len(p.Sizes) > 0 {
							<fieldset class="opts">
								<legend>Talla</legend>
								for _, o := range p.Sizes {
									<label class="opt">
										<input type="radio" name="talla" value={ o.Name } required disabled?={ o.SoldOut }/>
										<span>{ o.Name }</span>
										if o.SoldOut {
											<span class="sr-only">(agotada)</span>
										}
									</label>
								}
							</fieldset>
						}
						if len(p.Colors) > 0 {
							<fieldset class="opts">
								<legend>Color</legend>
								for i, o := range p.Colors {
									<label class="opt color">
										<input type="radio" name="color" value={ o.Name } required disabled?={ o.SoldOut }/>
										if o.Swatch != "" {
											<span class={ "sw", "sw-" + strconv.Itoa(i) } aria-hidden="true"></span>
										}
										<span>{ o.Name }</span>
										if o.SoldOut {
											<span class="sr-only">(agotado)</span>
										}
									</label>
								}
							</fieldset>
						}
						<label class="qty">
							<span>Cantidad</span>
							<input type="number" name="cantidad" value="1" min="1" max="20" inputmode="numeric"/>
						</label>
						<button type="submit" class="primary">Agregar al carrito</button>
						<p role="status" class="add-status" data-add-status></p>
						<noscript><p class="muted">Activa JavaScript para usar el carrito.</p></noscript>
					</form>
				}
				<a class="share" href={ templ.SafeURL("https://wa.me/?text=" + url.QueryEscape(p.Name+" "+sh.URL)) } rel="noopener">Compartir por WhatsApp</a>
				if p.Description != "" {
					<div class="desc">
						for _, line := range strings.Split(p.Description, "\n") {
							if strings.TrimSpace(line) != "" {
								<p>{ line }</p>
							}
						}
					</div>
				}
			</div>
		</article>
	}
}

templ ShopFAQ(sh Shop) {
	@shopPage(sh, "Preguntas frecuentes · "+sh.Name, "Cómo comprar en "+sh.Name+": pedidos, pagos y entregas por WhatsApp.", false) {
		<h1 class="page-h">Preguntas frecuentes</h1>
		<div class="faq">
			<details>
				<summary>¿Cómo hago mi pedido?</summary>
				<p>Elige tus productos, talla y color, agrégalos al carrito y toca "Enviar pedido por WhatsApp". Se abre WhatsApp con tu pedido ya escrito; solo envíalo.</p>
			</details>
			<details>
				<summary>¿Cómo pago?</summary>
				<p>{ sh.Name } te responde por WhatsApp para confirmar existencias y acordar el pago.</p>
				if sh.Payment != "" {
					<p class="pay">{ sh.Payment }</p>
				}
			</details>
			<details>
				<summary>¿Cómo me llega?</summary>
				<p>La entrega o el envío se acuerdan por WhatsApp con { sh.Name }.</p>
			</details>
			<details>
				<summary>¿Mi carrito se guarda?</summary>
				<p>Sí, en este celular. Si cambias de celular o borras los datos del navegador, se vacía.</p>
			</details>
			for _, qa := range sh.FAQ {
				<details>
					<summary>{ qa.Q }</summary>
					if qa.A != "" {
						<p class="pay">{ qa.A }</p>
					}
				</details>
			}
		</div>
	}
}

templ Paused() {
	<!DOCTYPE html>
	<html lang="es-MX">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>Tienda en pausa</title>
			<link rel="stylesheet" href="/static/css/vitrina.css"/>
		</head>
		<body>
			<main class="paused">
				<h1 class="page-h">Tienda en pausa</h1>
				<p>Esta tienda no está recibiendo pedidos por ahora. Vuelve a intentarlo más tarde.</p>
			</main>
		</body>
	</html>
}
