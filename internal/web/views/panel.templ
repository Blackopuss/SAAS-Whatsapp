package views

import (
	"context"
	"strconv"

	"github.com/Blackopuss/SAAS-Whatsapp/internal/db"
)

// Las páginas del panel de la vendedora las pinta frontend/src/panel.tsx; aquí solo se arman sus datos.

templ Login(store, email, errMsg string) {
	@reactPage("Entrar · "+store, "", "panel", "login", map[string]string{"store": store, "email": email, "error": errMsg})
}

// panelData agrega lo que toda página del panel necesita: nombre de la tienda y aviso de cobro.
func panelData(ctx context.Context, store string, data map[string]any) map[string]any {
	data["store"] = store
	data["notice"] = noticeFrom(ctx)
	return data
}

func money(cents int32) string {
	s := strconv.FormatInt(int64(cents)/100, 10)
	for i := len(s) - 3; i > 0; i -= 3 {
		s = s[:i] + "," + s[i:]
	}
	if c := cents % 100; c != 0 {
		return "$" + s + "." + strconv.FormatInt(int64(c)+100, 10)[1:]
	}
	return "$" + s
}

func idStr(id int64) string { return strconv.FormatInt(id, 10) }

type productRow struct {
	ID      int64  `json:"id"`
	Name    string `json:"name"`
	Price   string `json:"price"`
	Was     string `json:"was"` // precio normal tachado cuando está en oferta
	Active  bool   `json:"active"`
	SoldOut bool   `json:"soldOut"`
	IsNew   bool   `json:"isNew"`
	OnSale  bool   `json:"onSale"`
}

func productRows(ps []db.Product) []productRow {
	out := make([]productRow, 0, len(ps))
	for _, p := range ps {
		r := productRow{ID: p.ID, Name: p.Name, Price: money(p.PriceCents), Active: p.Active, SoldOut: p.SoldOut, IsNew: p.IsNew, OnSale: p.OnSale}
		if p.SalePriceCents.Valid && p.OnSale {
			r.Was, r.Price = r.Price, money(p.SalePriceCents.Int32)
		}
		out = append(out, r)
	}
	return out
}

templ Products(store string, ps []db.Product) {
	@reactPage("Productos · "+store, "", "panel", "products", panelData(ctx, store, map[string]any{"products": productRows(ps)}))
}

type option struct {
	Value string `json:"value"`
	Label string `json:"label"`
}

func categoryOptions(cats []db.Category) []option {
	out := make([]option, 0, len(cats))
	for _, c := range cats {
		out = append(out, option{idStr(c.ID), c.Name})
	}
	return out
}

templ Categories(store string, cats []db.Category, errMsg string) {
	@reactPage("Categorías · "+store, "", "panel", "categories", panelData(ctx, store, map[string]any{"categories": categoryOptions(cats), "error": errMsg}))
}

type VariantRow struct {
	Key, Label string
	SoldOut    bool
}

type ProductForm struct {
	ID                                  int64
	Name, Description, Price, SalePrice string
	CategoryID                          int64
	Sizes, Colors                       string
	Variants                            []VariantRow
	Error                               string
	Saved                               bool
	Photos                              []Photo
	PhotoOK                             bool
	PhotoError                          string
}

// Photo: srcset ya armados por el handler.
type Photo struct {
	ID          int64
	Src, SrcSet string
	OG          string // JPG para og:image
}

func productEditData(ctx context.Context, store string, cats []db.Category, f ProductForm) map[string]any {
	cat := ""
	if f.CategoryID != 0 {
		cat = idStr(f.CategoryID)
	}
	return panelData(ctx, store, map[string]any{"form": f, "category": cat, "categories": categoryOptions(cats)})
}

templ ProductEdit(store string, cats []db.Category, f ProductForm) {
	@reactPage(map[bool]string{true: "Nuevo producto", false: "Editar producto"}[f.ID == 0]+" · "+store, "", "panel", "productEdit", productEditData(ctx, store, cats, f))
}

type StoreForm struct {
	Name, ShopURL, Whatsapp string
	Color, Applied          string // Color: el que eligió; Applied: el que se usa (ajustado)
	FAQ, Payment            string
	Style                   string
	Logo                    Photo
	Error, LogoError        string
	Saved, Adjusted, LogoOK bool
}

func myStoreData(ctx context.Context, f StoreForm) map[string]any {
	f.Style = StyleByID(f.Style).ID
	adjusted := f.Adjusted && isHex(f.Color) && isHex(f.Applied)
	return panelData(ctx, f.Name, map[string]any{"form": f, "adjusted": adjusted, "styles": Styles})
}

templ MyStore(f StoreForm) {
	@reactPage("Mi tienda · "+f.Name, "", "panel", "myStore", myStoreData(ctx, f))
}

type noticeKey struct{}

// WithNotice guarda el aviso de cobro para que lo pinte cualquier página del panel.
func WithNotice(ctx context.Context, msg string) context.Context {
	return context.WithValue(ctx, noticeKey{}, msg)
}

func noticeFrom(ctx context.Context) string {
	s, _ := ctx.Value(noticeKey{}).(string)
	return s
}

templ Messages(store, shopURL, payment string) {
	@reactPage("Mensajes · "+store, "", "panel", "messages", panelData(ctx, store, map[string]any{"shopURL": shopURL, "payment": payment}))
}
