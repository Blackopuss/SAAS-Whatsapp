package views

templ Login(store, email, errMsg string) {
	@page("Entrar · " + store) {
		<main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center p-4">
			<h1 class="text-2xl font-bold">Entrar a tu panel</h1>
			<p class="mt-1 text-stone-600">{ store }</p>
			<form method="post" action="/panel/login" class="mt-6 flex flex-col gap-4" novalidate>
				if errMsg != "" {
					<p role="alert" class="rounded-md border border-red-300 bg-red-50 p-3 text-red-800">{ errMsg }</p>
				}
				<div class="flex flex-col gap-1">
					<label for="email" class="font-medium">Email</label>
					<input id="email" name="email" type="email" value={ email } autocomplete="username" required autofocus?={ email == "" } class="min-h-12 rounded-md border border-stone-400 bg-white px-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"/>
				</div>
				<div class="flex flex-col gap-1">
					<label for="password" class="font-medium">Contraseña</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required autofocus?={ email != "" } class="min-h-12 rounded-md border border-stone-400 bg-white px-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"/>
				</div>
				<button type="submit" class="min-h-12 rounded-md bg-stone-900 px-4 font-semibold text-white hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900">Entrar</button>
			</form>
		</main>
	}
}

templ PanelHome(store string) {
	@page("Panel · " + store) {
		<main class="mx-auto max-w-xl p-4">
			<div class="flex items-center justify-between gap-4">
				<h1 class="text-2xl font-bold">{ store }</h1>
				<form method="post" action="/panel/logout">
					<button type="submit" class="min-h-11 rounded-md border border-stone-400 px-4 font-medium hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900">Salir</button>
				</form>
			</div>
			<p class="mt-4 text-stone-600">Aquí vas a dar de alta tus productos (sprint 2).</p>
		</main>
	}
}
