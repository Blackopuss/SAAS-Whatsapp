package views

import (
	"context"
	"strconv"

	"github.com/Blackopuss/SAAS-Whatsapp/internal/db"
)

const (
	input  = "min-h-12 w-full rounded-lg border border-stone-400 bg-white px-3 shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"
	btn    = "inline-flex min-h-12 items-center justify-center rounded-lg bg-stone-900 px-5 font-semibold text-white shadow-sm hover:bg-stone-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"
	btnAlt = "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-400 bg-white px-3 font-medium hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900"
)

templ Login(store, email, errMsg string) {
	@page("Entrar · "+store, "") {
		<main class="mx-auto flex min-h-dvh max-w-sm flex-col justify-center p-5">
			<h1 class="text-3xl font-bold tracking-tight">Entrar a tu panel</h1>
			<p class="mt-1 text-stone-600">{ store }</p>
			<form method="post" action="/panel/login" class="mt-6 flex flex-col gap-4 rounded-xl border border-stone-200 bg-white p-5 shadow-sm" novalidate>
				@alert(errMsg)
				<div class="flex flex-col gap-1">
					<label for="email" class="font-medium">Email</label>
					<input id="email" name="email" type="email" value={ email } autocomplete="username" required autofocus?={ email == "" } class={ input }/>
				</div>
				<div class="flex flex-col gap-1">
					<label for="password" class="font-medium">Contraseña</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required autofocus?={ email != "" } class={ input }/>
				</div>
				<button type="submit" class={ btn }>Entrar</button>
			</form>
			<p class="mt-6"><a href="/panel/recuperar" class="font-medium underline underline-offset-4">¿Olvidaste tu contraseña?</a></p>
		</main>
	}
}

templ alert(msg string) {
	if msg != "" {
		<p role="alert" class="rounded-md border border-red-300 bg-red-50 p-3 text-red-800">{ msg }</p>
	}
}

// panelPage: navegación inferior fija para usarlo con el pulgar (plan 3.6).
templ panelPage(store, title, current string) {
	@page(title+" · "+store, "") {
		<main class="mx-auto max-w-xl p-4 pb-28 sm:p-6 sm:pb-28">
			if n := noticeFrom(ctx); n != "" {
				<p class="mb-4 rounded-md border border-amber-300 bg-amber-50 p-3 text-amber-950">{ n }</p>
			}
			{ children... }
		</main>
		<nav aria-label="Panel" class="fixed inset-x-0 bottom-0 border-t border-stone-300 bg-white pb-[env(safe-area-inset-bottom)] shadow-[0_-4px_16px_rgb(0_0_0/0.05)]">
			<ul class="mx-auto grid max-w-xl grid-cols-4">
				@navItem("/panel/", "Productos", current == "productos")
				@navItem("/panel/categorias", "Categorías", current == "categorias")
				@navItem("/panel/tienda", "Mi tienda", current == "tienda")
				<li>
					<form method="post" action="/panel/logout">
						<button type="submit" class="flex min-h-14 w-full items-center justify-center font-medium text-stone-700 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-stone-900">Salir</button>
					</form>
				</li>
			</ul>
		</nav>
	}
}

templ navItem(href, label string, active bool) {
	<li>
		<a
			href={ templ.SafeURL(href) }
			aria-current?={ active }
			class={ "flex min-h-14 items-center justify-center font-medium focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-stone-900",
				templ.KV("text-stone-950 underline decoration-2 underline-offset-8", active),
				templ.KV("text-stone-700", !active) }
		>{ label }</a>
	</li>
}

func money(cents int32) string {
	s := strconv.FormatInt(int64(cents)/100, 10)
	for i := len(s) - 3; i > 0; i -= 3 {
		s = s[:i] + "," + s[i:]
	}
	if c := cents % 100; c != 0 {
		return "$" + s + "." + strconv.FormatInt(int64(c)+100, 10)[1:]
	}
	return "$" + s
}

func idStr(id int64) string { return strconv.FormatInt(id, 10) }

templ Products(store string, ps []db.Product) {
	@panelPage(store, "Productos", "productos") {
		<div class="flex items-center justify-between gap-4">
			<h1 class="text-2xl font-bold">Productos</h1>
			<a href="/panel/productos/nuevo" class={ btn + " shrink-0" }>Agregar producto</a>
		</div>
		if len(ps) == 0 {
			<div class="mt-8 rounded-lg border border-dashed border-stone-400 p-6">
				<p class="font-medium">Aún no tienes productos.</p>
				<p class="mt-1 text-stone-600">Agrega el primero; luego puedes ordenarlos por categoría.</p>
			</div>
		}
		<ul class="mt-6 flex flex-col gap-3">
			for _, p := range ps {
				<li id={ "p" + idStr(p.ID) } class={ "rounded-lg border border-stone-300 bg-white p-4", templ.KV("opacity-70", !p.Active) }>
					<div class="flex items-start justify-between gap-3">
						<a href={ templ.SafeURL("/panel/productos/" + idStr(p.ID)) } class="font-semibold underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-stone-900">{ p.Name }</a>
						<span class="shrink-0 tabular-nums">
							if p.SalePriceCents.Valid && p.OnSale {
								<s class="text-stone-500">{ money(p.PriceCents) }</s> { money(p.SalePriceCents.Int32) }
							} else {
								{ money(p.PriceCents) }
							}
						</span>
					</div>
					<div class="mt-3 flex flex-wrap gap-2">
						@toggle(p.ID, "active", "Visible", p.Active)
						@toggle(p.ID, "sold_out", "Agotado", p.SoldOut)
						@toggle(p.ID, "is_new", "Nuevo", p.IsNew)
						@toggle(p.ID, "on_sale", "Oferta", p.OnSale)
					</div>
				</li>
			}
		</ul>
	}
}

templ toggle(id int64, flag, label string, on bool) {
	<form method="post" action={ templ.SafeURL("/panel/productos/" + idStr(id) + "/marcar/" + flag) }>
		<button
			type="submit"
			aria-pressed={ strconv.FormatBool(on) }
			class={ "min-h-11 rounded-full border px-4 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900",
				templ.KV("border-stone-900 bg-stone-900 text-white", on),
				templ.KV("border-stone-400 bg-white text-stone-700", !on) }
		>
			if on {
				<span aria-hidden="true">✓ </span>
			}
			{ label }
		</button>
	</form>
}

templ Categories(store string, cats []db.Category, errMsg string) {
	@panelPage(store, "Categorías", "categorias") {
		<h1 class="text-2xl font-bold">Categorías</h1>
		<form method="post" action="/panel/categorias" class="mt-6 flex flex-col gap-2">
			@alert(errMsg)
			<label for="new-cat" class="font-medium">Nueva categoría</label>
			<div class="flex gap-2">
				<input id="new-cat" name="name" required maxlength="60" placeholder="Ej. Blusas" class={ input }/>
				<button type="submit" class={ btn }>Agregar</button>
			</div>
		</form>
		<ol class="mt-6 flex flex-col gap-3">
			for i, c := range cats {
				<li class="rounded-lg border border-stone-300 bg-white p-3">
					<form method="post" action={ templ.SafeURL("/panel/categorias/" + idStr(c.ID) + "/renombrar") } class="flex gap-2">
						<label for={ "cat-" + idStr(c.ID) } class="sr-only">Nombre de la categoría</label>
						<input id={ "cat-" + idStr(c.ID) } name="name" value={ c.Name } required maxlength="60" class={ input }/>
						<button type="submit" class={ btnAlt }>Guardar</button>
					</form>
					<div class="mt-2 flex gap-2">
						<form method="post" action={ templ.SafeURL("/panel/categorias/" + idStr(c.ID) + "/mover") }>
							<input type="hidden" name="dir" value="up"/>
							<button type="submit" disabled?={ i == 0 } class={ btnAlt + " disabled:opacity-40" }>Subir<span class="sr-only"> { c.Name }</span></button>
						</form>
						<form method="post" action={ templ.SafeURL("/panel/categorias/" + idStr(c.ID) + "/mover") }>
							<input type="hidden" name="dir" value="down"/>
							<button type="submit" disabled?={ i == len(cats)-1 } class={ btnAlt + " disabled:opacity-40" }>Bajar<span class="sr-only"> { c.Name }</span></button>
						</form>
						<form method="post" action={ templ.SafeURL("/panel/categorias/" + idStr(c.ID) + "/borrar") } class="ml-auto">
							<button type="submit" class={ btnAlt + " text-red-800" }>Borrar<span class="sr-only"> { c.Name }</span></button>
						</form>
					</div>
				</li>
			}
		</ol>
	}
}

type VariantRow struct {
	Key, Label string
	SoldOut    bool
}

type ProductForm struct {
	ID                                  int64
	Name, Description, Price, SalePrice string
	CategoryID                          int64
	Sizes, Colors                       string
	Variants                            []VariantRow
	Error                               string
	Saved                               bool
	Photos                              []Photo
	PhotoOK                             bool
	PhotoError                          string
}

// Photo: srcset ya armados por el handler.
type Photo struct {
	ID          int64
	Src, SrcSet string
	OG          string // JPG para og:image
}

templ ProductEdit(store string, cats []db.Category, f ProductForm) {
	@panelPage(store, map[bool]string{true: "Nuevo producto", false: "Editar producto"}[f.ID == 0], "productos") {
		<a href="/panel/" class="text-stone-700 underline underline-offset-4">← Productos</a>
		<h1 class="mt-2 text-2xl font-bold">
			if f.ID == 0 {
				Nuevo producto
			} else {
				Editar producto
			}
		</h1>
		<form
			method="post"
			action={ templ.SafeURL(map[bool]string{true: "/panel/productos", false: "/panel/productos/" + idStr(f.ID)}[f.ID == 0]) }
			class="mt-6 flex flex-col gap-5"
			novalidate
		>
			@alert(f.Error)
			if f.Saved {
				<p role="status" class="rounded-md border border-green-300 bg-green-50 p-3 text-green-900">Producto guardado.</p>
			}
			@field("name", "Nombre") {
				<input id="name" name="name" value={ f.Name } required maxlength="120" class={ input }/>
			}
			<div class="flex flex-col gap-5">
				@field("price", "Precio") {
					<input id="price" name="price" value={ f.Price } inputmode="decimal" required placeholder="289" class={ input }/>
				}
				@field("sale_price", "Oferta (opcional)") {
					<input id="sale_price" name="sale_price" value={ f.SalePrice } inputmode="decimal" placeholder="249" class={ input }/>
				}
			</div>
			@field("category_id", "Categoría") {
				<select id="category_id" name="category_id" class={ input }>
					<option value="">Sin categoría</option>
					for _, c := range cats {
						<option value={ idStr(c.ID) } selected?={ c.ID == f.CategoryID }>{ c.Name }</option>
					}
				</select>
			}
			@field("sizes", "Tallas") {
				<input id="sizes" name="sizes" value={ f.Sizes } aria-describedby="sizes-help" placeholder="S, M, L" class={ input }/>
				<p id="sizes-help" class="text-sm text-stone-600">Sepáralas con comas. Déjalo vacío si es talla única.</p>
			}
			@field("colors", "Colores") {
				<input id="colors" name="colors" value={ f.Colors } aria-describedby="colors-help" placeholder="Negro, Blanco" class={ input }/>
				<p id="colors-help" class="text-sm text-stone-600">Sepáralos con comas. Déjalo vacío si hay un solo color.</p>
			}
			if len(f.Variants) > 0 {
				<fieldset class="rounded-lg border border-stone-300 p-3">
					<legend class="px-1 font-medium">¿Qué combinaciones están agotadas?</legend>
					<div class="mt-2 grid grid-cols-2 gap-2">
						for _, v := range f.Variants {
							<label class="flex min-h-11 items-center gap-2">
								<input type="checkbox" name="soldout" value={ v.Key } checked?={ v.SoldOut } class="size-5"/>
								{ v.Label }
							</label>
						}
					</div>
				</fieldset>
			}
			@field("description", "Descripción") {
				<textarea id="description" name="description" rows="5" maxlength="4000" class={ input + " py-2" }>{ f.Description }</textarea>
			}
			<button type="submit" class={ btn }>Guardar producto</button>
		</form>
		if f.ID != 0 {
			@photos(f)
			<details class="mt-8 border-t border-stone-300 pt-6">
				<summary class={ btnAlt + " cursor-pointer text-red-800" }>Borrar producto</summary>
				<form method="post" action={ templ.SafeURL("/panel/productos/" + idStr(f.ID) + "/borrar") } class="mt-3 flex items-center gap-3">
					<p>Se borra para siempre, con sus fotos.</p>
					<button type="submit" class={ btn + " bg-red-800 hover:bg-red-700" }>Sí, borrar</button>
				</form>
			</details>
		}
	}
}

templ field(id, label string) {
	<div class="flex flex-col gap-1">
		<label for={ id } class="font-medium">{ label }</label>
		{ children... }
	</div>
}

templ photos(f ProductForm) {
	<section id="fotos" aria-labelledby="fotos-h" class="mt-8 border-t border-stone-300 pt-6">
		<h2 id="fotos-h" class="text-xl font-bold">Fotos <span class="font-normal text-stone-600">({ strconv.Itoa(len(f.Photos)) } de 10)</span></h2>
		<div aria-live="polite" class="mt-3 empty:hidden" data-foto-estado>
			@alert(f.PhotoError)
			if f.PhotoOK {
				<p role="status" class="rounded-md border border-green-300 bg-green-50 p-3 text-green-900">Foto agregada.</p>
			}
		</div>
		if len(f.Photos) > 0 {
			<ul class="mt-4 grid grid-cols-2 gap-3">
				for i, p := range f.Photos {
					<li class="overflow-hidden rounded-lg border border-stone-300 bg-white">
						<img src={ p.Src } srcset={ p.SrcSet } sizes="(min-width: 576px) 270px, 45vw" alt={ "Foto " + strconv.Itoa(i+1) + " de " + f.Name } loading="lazy" decoding="async" width="400" height="500" class="aspect-[4/5] w-full bg-stone-200 object-cover"/>
						<form method="post" action={ templ.SafeURL("/panel/fotos/" + idStr(p.ID) + "/borrar") } class="p-2">
							<button type="submit" class={ btnAlt + " w-full text-red-800" }>Quitar<span class="sr-only"> foto { strconv.Itoa(i+1) }</span></button>
						</form>
					</li>
				}
			</ul>
		}
		if len(f.Photos) < 10 {
			<form method="post" enctype="multipart/form-data" action={ templ.SafeURL("/panel/productos/" + idStr(f.ID) + "/fotos") } class="mt-4 flex flex-col gap-2" data-foto-form>
				<label for="foto" class="font-medium">Agregar foto</label>
				<input id="foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp" required aria-describedby="foto-help" class="min-h-12 rounded-md border border-stone-500 bg-white p-2 file:mr-3 file:min-h-10 file:rounded file:border-0 file:bg-stone-200 file:px-3 file:font-medium"/>
				<p id="foto-help" class="text-sm text-stone-600">JPG, PNG o WebP. La reducimos en tu celular antes de subirla para ahorrar datos.</p>
				<button type="submit" class={ btn }>Subir foto</button>
			</form>
			<script src="/static/js/fotos.js" defer></script>
		}
	</section>
}

type StoreForm struct {
	Name, ShopURL, Whatsapp  string
	Color, Applied           string // Color: el que eligió; Applied: el que se usa (ajustado)
	FAQ, Payment             string
	Style                    string
	Logo                     Photo
	Error, LogoError         string
	Saved, Adjusted, LogoOK  bool
}

templ MyStore(f StoreForm) {
	@panelPage(f.Name, "Mi tienda", "tienda") {
		<h1 class="text-2xl font-bold">Mi tienda</h1>
		<p class="mt-2">Tu tienda: <a href={ templ.SafeURL(f.ShopURL) } class="font-medium underline underline-offset-4">{ f.ShopURL }</a></p>
		<form method="post" action="/panel/tienda" class="mt-6 flex flex-col gap-5" novalidate data-preview-form>
			@alert(f.Error)
			if f.Saved {
				<p role="status" class="rounded-md border border-green-300 bg-green-50 p-3 text-green-900">Datos guardados.</p>
			}
			if f.Adjusted && isHex(f.Color) && isHex(f.Applied) {
				@nonceStyle(".sw-antes{background:" + f.Color + "}.sw-ahora{background:" + f.Applied + "}")
				<div class="rounded-md border border-amber-300 bg-amber-50 p-3 text-amber-950">
					<p>Ajustamos un poco tu color para que los botones se lean bien en cualquier celular.</p>
					<p class="mt-2 flex items-center gap-4">
						<span class="flex items-center gap-2"><span class="sw-antes inline-block size-6 rounded-full border border-stone-500"></span>Antes { f.Color }</span>
						<span class="flex items-center gap-2"><span class="sw-ahora inline-block size-6 rounded-full border border-stone-500"></span>Ahora { f.Applied }</span>
					</p>
				</div>
			}
			@helpField("name", "Nombre de la tienda", "") {
				<input id="name" name="name" type="text" value={ f.Name } maxlength="80" required class={ input }/>
			}
			@helpField("whatsapp", "WhatsApp para recibir pedidos", "10 dígitos si es de México, por ejemplo 55 1234 5678. Si es de otro país, empieza con + y la lada.") {
				<input id="whatsapp" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" value={ f.Whatsapp } aria-describedby="whatsapp-help" class={ input }/>
			}
			@helpField("color", "Color de tu marca", "Lo usamos en los botones. Si no se lee bien, lo ajustamos un poco.") {
				<input id="color" name="color" type="color" value={ f.Color } aria-describedby="color-help" class="h-12 w-24 cursor-pointer rounded-md border border-stone-500 bg-white p-1"/>
			}
			<fieldset class="flex flex-col gap-2">
				<legend class="font-medium">Estilo de tu tienda</legend>
				<p class="text-sm text-stone-600">Elige el que va con tu giro. Al elegirlo te sugerimos su color; puedes cambiarlo.</p>
				for _, st := range Styles {
					<label class={ "style-choice style-choice-" + st.ID, "flex min-h-11 cursor-pointer items-start gap-3 rounded-md border border-stone-300 bg-white p-3 has-checked:border-stone-900 has-checked:ring-2 has-checked:ring-stone-900" }>
						<input type="radio" name="style" value={ st.ID } data-color={ st.Brand } checked?={ StyleByID(f.Style).ID == st.ID } class="mt-1 size-5"/>
						<span class="style-copy"><span class="style-sample">{ st.Name }</span><span class="block text-sm text-stone-600">{ st.Hint }</span></span>
					</label>
				}
			</fieldset>
			@helpField("payment", "Datos para pagar por transferencia (opcional)", "Banco, CLABE y a nombre de quién. Se muestran en las preguntas frecuentes de tu tienda.") {
				<textarea id="payment" name="payment" rows="3" maxlength="1000" aria-describedby="payment-help" class={ input }>{ f.Payment }</textarea>
			}
			@helpField("faq", "Tus preguntas frecuentes (opcional)", "Escribe la pregunta en una línea y la respuesta abajo. Deja una línea vacía entre preguntas.") {
				<textarea id="faq" name="faq" rows="6" maxlength="4000" aria-describedby="faq-help" class={ input }>{ f.FAQ }</textarea>
			}
			<button type="submit" class={ btn }>Guardar datos</button>
		</form>

		<section aria-labelledby="vista-h" class="mt-8 border-t border-stone-300 pt-6">
			<h2 id="vista-h" class="text-xl font-bold">Vista previa</h2>
			<p class="mt-1 text-sm text-stone-600">Cambia el nombre, el color o el estilo arriba y aquí ves cómo queda, antes de guardar.</p>
			<iframe src="/panel/tienda/vista" title="Vista previa de tu tienda" loading="lazy" class="mt-3 h-[32rem] w-full rounded-lg border border-stone-300 bg-white" data-preview></iframe>
		</section>

		<section id="logo" aria-labelledby="logo-h" class="mt-8 border-t border-stone-300 pt-6">
			<h2 id="logo-h" class="text-xl font-bold">Logo</h2>
			<div aria-live="polite" class="mt-3 empty:hidden">
				@alert(f.LogoError)
				if f.LogoOK {
					<p role="status" class="rounded-md border border-green-300 bg-green-50 p-3 text-green-900">Logo guardado.</p>
				}
			</div>
			if f.Logo.Src != "" {
				<img src={ f.Logo.Src } alt={ "Logo de " + f.Name } width="96" height="96" class="mt-3 size-24 rounded-md border border-stone-300 bg-white object-contain"/>
				<form method="post" action="/panel/tienda/logo/borrar" class="mt-3">
					<button type="submit" class={ btnAlt + " text-red-800" }>Quitar logo</button>
				</form>
			}
			<form method="post" enctype="multipart/form-data" action="/panel/tienda/logo" class="mt-4 flex flex-col gap-2">
				<label for="logo-file" class="font-medium">{ logoLabel(f.Logo.Src != "") }</label>
				<input id="logo-file" name="logo" type="file" accept="image/jpeg,image/png,image/webp" required class="min-h-12 rounded-md border border-stone-500 bg-white p-2 file:mr-3 file:min-h-10 file:rounded file:border-0 file:bg-stone-200 file:px-3 file:font-medium"/>
				<button type="submit" class={ btn }>Subir logo</button>
			</form>
		</section>

		<section aria-labelledby="qr-h" class="mt-8 border-t border-stone-300 pt-6">
			<h2 id="qr-h" class="text-xl font-bold">QR de tu tienda</h2>
			<p class="mt-1 text-sm text-stone-600">Imprímelo o compártelo; al escanearlo abre tu tienda.</p>
			<img src="/panel/tienda/qr.png" alt={ "Código QR que abre " + f.ShopURL } width="240" height="240" loading="lazy" class="mt-3 size-60 border border-stone-300 bg-white"/>
			<a href="/panel/tienda/qr.png?descargar" class={ btnAlt + " mt-3 inline-flex" }>Descargar QR</a>
		</section>
		<script src="/static/js/mitienda.js" defer></script>
	}
}

func logoLabel(has bool) string {
	if has {
		return "Cambiar logo"
	}
	return "Subir logo"
}

// helpField: campo con texto de ayuda ligado por aria-describedby (id + "-help").
templ helpField(id, label, help string) {
	<div class="flex flex-col gap-1">
		<label for={ id } class="font-medium">{ label }</label>
		{ children... }
		if help != "" {
			<p id={ id + "-help" } class="text-sm text-stone-600">{ help }</p>
		}
	</div>
}

type noticeKey struct{}

// WithNotice guarda el aviso de cobro para que lo pinte cualquier página del panel.
func WithNotice(ctx context.Context, msg string) context.Context {
	return context.WithValue(ctx, noticeKey{}, msg)
}

func noticeFrom(ctx context.Context) string {
	s, _ := ctx.Value(noticeKey{}).(string)
	return s
}
