package views

// Hello: la raíz del dominio (sin tienda). Sin estilos a propósito; la página de presentación llega después.
templ Hello() {
	<!DOCTYPE html>
	<html lang="es-MX">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Tiendas</title>
		</head>
		<body>
			<main>
				<h1>Hola</h1>
			</main>
		</body>
	</html>
}
