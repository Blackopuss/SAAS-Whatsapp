{
	# API de administración por socket Unix (solo el usuario caddy), no por TCP: otro proceso del VPS no puede reconfigurar el proxy.
	admin unix//run/caddy/admin.sock
	servers {
		# Lista de Cloudflare (refrescar junto con cloudflare-ufw.sh).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		# La IP real sale de CF-Connecting-IP, que Cloudflare escribe y la compradora no puede falsificar.
		# (Con el default, X-Forwarded-For, el primer valor lo pone quien hace la petición.)
		client_ip_headers CF-Connecting-IP
	}
}

{$BASE_DOMAIN}, *.{$BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	encode zstd gzip
	# La aplicación ya escribe CSP, HSTS no; estos headers solo completan el proxy.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	log {
		output file /var/log/caddy/tiendas-access.json {
			roll_size 100MiB
			roll_keep 14
			roll_keep_for 336h
		}
		format filter {
			request>uri query {
				delete t
			}
			# La página de recuperar ya manda Referrer-Policy: no-referrer; esto es por si un navegador no la respeta.
			request>headers>Referer delete
			wrap json
		}
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}
	}
}

