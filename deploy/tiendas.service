[Unit]
Description=Aplicación SaaS Tiendas
After=network-online.target postgresql.service tiendas-migrate.service
Wants=network-online.target
# Las migraciones corren antes, en su propia unidad y con su propio usuario (nada del release corre como root).
Requires=postgresql.service tiendas-migrate.service

[Service]
Type=simple
User=tiendas
Group=tiendas
WorkingDirectory=/opt/tiendas/current
EnvironmentFile=/etc/tiendas/env
ExecStart=/opt/tiendas/current/bin/server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
