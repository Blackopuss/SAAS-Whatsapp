[Unit]
Description=Respaldo cifrado de PostgreSQL de Tiendas
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/tiendas/backup.env
# Copia instalada por root (setup), no la del release: quien sube releases no decide qué corre como root.
ExecStart=/usr/local/sbin/tiendas-backup
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tiendas/backups
